<%-- any content can be specified here e.g.: --%>
<%@ page pageEncoding="UTF-8" %>
<%-- ============================================================
     employeeEditModal.jsp
     Fragment à inclure UNE SEULE FOIS, avant </body>.
     Appelé via : openEmployeeModal(btnElement)
     Sauvegarde via : UpdateEmployeeServlet (POST JSON)
     ============================================================ --%>

<style>
    /* Overlay */
    .em-overlay {
        position: fixed;
        inset: 0;
        z-index: 1000;
        background: rgba(0, 0, 0, 0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        animation: em-fade-in .15s ease;
    }
    @keyframes em-fade-in {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    /* Card */
    .em-card {
        background: #fff;
        border-radius: 14px;
        border: 1px solid #e4e4e4;
        width: 100%;
        max-width: 440px;
        box-shadow: 0 8px 32px rgba(0,0,0,.12);
        animation: em-slide-up .18s ease;
        overflow: hidden;
    }
    @keyframes em-slide-up {
        from {
            transform: translateY(12px);
            opacity: 0;
        }
        to   {
            transform: translateY(0);
            opacity: 1;
        }
    }

    /* Header */
    .em-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        border-bottom: 1px solid #f0f0f0;
    }
    .em-header-title {
        font-size: 13px;
        font-weight: 600;
        color: #555;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .em-close {
        background: none;
        border: none;
        cursor: pointer;
        color: #999;
        font-size: 18px;
        line-height: 1;
        padding: 2px 4px;
        border-radius: 6px;
        transition: background .15s, color .15s;
    }
    .em-close:hover {
        background: #f4f4f4;
        color: #333;
    }

    /* Card top */
    .em-card-top {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px;
    }
    .em-avatar {
        width: 58px;
        height: 58px;
        border-radius: 50%;
        background: #e8f0fe;
        color: #3b5bdb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 17px;
        flex-shrink: 0;
        letter-spacing: .5px;
    }
    .em-card-meta {
        flex: 1;
        min-width: 0;
    }
    .em-emp-id {
        font-size: 11px;
        color: #aaa;
        margin-bottom: 4px;
    }

    /* Inputs */
    .em-input {
        width: 100%;
        box-sizing: border-box;
        border: 1px solid #e4e4e4;
        border-radius: 8px;
        padding: 6px 10px;
        font-size: 13px;
        color: #222;
        background: #fafafa;
        transition: border-color .15s, background .15s;
        outline: none;
    }
    .em-input:focus {
        border-color: #6c8ef0;
        background: #fff;
    }
    .em-input[type="range"] {
        padding: 0;
        background: none;
        border: none;
        cursor: pointer;
    }

    .em-input-name {
        font-weight: 600;
        font-size: 14px;
        margin-bottom: 6px;
    }
    .em-input-role {
        font-size: 12px;
        border-radius: 99px;
        text-align: center;
        padding: 3px 10px;
    }

    /* Divider */
    .em-divider {
        height: 1px;
        background: #f0f0f0;
        margin: 0 16px;
    }

    /* Details grid */
    .em-details {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        padding: 14px 16px;
    }
    .em-detail-item {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }
    .em-full {
        grid-column: 1 / -1;
    }
    .em-label {
        font-size: 11px;
        color: #aaa;
        text-transform: uppercase;
        letter-spacing: .5px;
        display: flex;
        justify-content: space-between;
    }
    .em-leave-counter {
        font-weight: 600;
        color: #555;
    }

    /* Leave bar */
    .em-leave-section {
        padding: 12px 16px;
    }
    .em-leave-bar-label {
        display: flex;
        justify-content: space-between;
        font-size: 12px;
        color: #888;
        margin-bottom: 7px;
    }
    .em-leave-bar {
        background: #f0f0f0;
        border-radius: 99px;
        height: 7px;
        overflow: hidden;
    }
    .em-leave-bar-fill {
        height: 100%;
        background: #6c8ef0;
        border-radius: 99px;
        transition: width .25s ease;
    }

    /* Footer */
    .em-footer {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 16px;
        border-top: 1px solid #f0f0f0;
    }
    .em-btn {
        border-radius: 8px;
        padding: 7px 16px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: background .15s, opacity .15s;
    }
    .em-btn-cancel {
        background: none;
        border: 1px solid #ddd;
        color: #555;
        margin-left: auto;
    }
    .em-btn-cancel:hover {
        background: #f6f6f6;
    }
    .em-btn-save {
        background: #6c8ef0;
        border: none;
        color: #fff;
    }
    .em-btn-save:hover {
        background: #5a7de0;
    }
    .em-btn-save:disabled {
        opacity: .55;
        cursor: not-allowed;
    }
    .em-btn-delete {
        background: none;
        border: 1px solid #e57373;
        color: #c62828;
        margin-right: auto;
    }
    .em-btn-delete:hover {
        background: #ffebee;
    }

    /* Toast / Error */
    .em-toast, .em-error {
        font-size: 12px;
        display: none;
        align-items: center;
        gap: 5px;
    }
    .em-toast {
        color: #2e7d32;
    }
    .em-error {
        color: #c62828;
    }
</style>

<%-- ── OVERLAY + MODAL ─────────────────────────────────────── --%>
<div id="employeeModal" class="em-overlay" role="dialog" aria-modal="true"
     aria-labelledby="em-title" style="display:none;">

    <div class="em-card">

        <%-- ── Header ──────────────────────────────────────── --%>
        <div class="em-header">
            <span id="em-title" class="em-header-title">
                <i class="ti ti-edit" aria-hidden="true"></i> Edit employee
            </span>
            <button class="em-close" onclick="closeEmployeeModal()" aria-label="Close modal">
                <i class="ti ti-x"></i>
            </button>
        </div>

        <%-- ── Card top : avatar + name + role ────────────── --%>
        <div class="em-card-top">
            <!-- Avatar -->
            <img id="em-avatar-img"
                 src=""
                 style="width:58px; height:58px; border-radius:50%;"
                 alt="Avatar" />

            <div class="em-card-meta">
                <div class="em-emp-id"># <span id="em-id-display">000000</span></div>
                <input  id="em-name"
                        class="em-input em-input-name"
                        type="text"
                        placeholder="Full name"
                        aria-label="Full name" />
                <input  id="em-role"
                        class="em-input em-input-role"
                        type="text"
                        placeholder="Role"
                        aria-label="Role" />
            </div>
        </div>

        <div class="em-divider"></div>

        <%-- ── Detail fields ───────────────────────────────── --%>
        <div class="em-details">

            <div class="em-detail-item">
                <label class="em-label" for="em-entrance">Entrance</label>
                <input id="em-entrance" class="em-input" type="date" aria-label="Entrance date" />
            </div>

            <div class="em-detail-item">
                <label class="em-label" for="em-phone">Phone</label>
                <input id="em-phone" class="em-input" type="tel"
                       placeholder="(+225) 000-000-00" aria-label="Phone" />
            </div>

            <div class="em-detail-item em-full">
                <label class="em-label" for="em-email">Email</label>
                <input id="em-email" class="em-input" type="email"
                       placeholder="email@company.com" aria-label="Email" />
            </div>

            <div class="em-detail-item">
                <label class="em-label" for="em-latest-leave">Latest leave</label>
                <input id="em-latest-leave" class="em-input" type="date" aria-label="Latest leave date" />
            </div>

            <div class="em-detail-item">
                <label class="em-label" for="em-leave-balance">
                    Leave used <span id="em-leave-counter" class="em-leave-counter">24 / 30</span>
                </label>
                <input 
                    id="em-leave-balance" 
                    class="em-input" 
                    type="range"
                    min="0"
                    max="26.4"
                    step="0.1"
                    value="0"
                    oninput="emUpdateLeaveBar(this.value)"
                    />
            </div>

        </div>

        <div class="em-divider"></div>

        <%-- ── Leave progress bar ──────────────────────────── --%>
        <div class="em-leave-section">
            <div class="em-leave-bar-label">
                <span>Leave balance</span>
                <span id="em-leave-text">24 / 30 days</span>
            </div>
            <div class="em-leave-bar">
                <div class="em-leave-bar-fill" id="em-leave-fill" style="width:80%"></div>
            </div>
        </div>

        <%-- ── Footer ──────────────────────────────────────── --%>
        <div class="em-footer">
            <span class="em-toast" id="em-toast">
                <i class="ti ti-check" aria-hidden="true"></i> Saved successfully
            </span>
            <span class="em-error" id="em-error">
                <i class="ti ti-alert-circle" aria-hidden="true"></i> <span id="em-error-msg"></span>
            </span>
            <button class="em-btn em-btn-delete" 
                    onclick="confirmDelete(document.getElementById('em-user-id').value, document.getElementById('em-name').value)">
                Delete
            </button>
            <button class="em-btn em-btn-cancel" onclick="closeEmployeeModal()">Cancel</button>
            <button class="em-btn em-btn-save"   onclick="emSaveEmployee()">
                Save changes
            </button>
        </div>

        <%-- hidden field to carry the userId --%>
        <input type="hidden" id="em-user-id" value="" />

    </div><%-- /em-card --%>
</div><%-- /em-overlay --%>



<%-- ── JAVASCRIPT ───────────────────────────────────────────── --%>
<script>
    /* ── Helpers ──────────────────────────────────────────────── */
    /**function emInitials(name) {
     const parts = (name || '').trim().split(/\s+/).filter(Boolean);
     return ((parts[0]?.[0] || '') + (parts[1]?.[0] || '')).toUpperCase() || '--';
     }
     
     function emUpdateAvatar(name) {
     document.getElementById('em-avatar').textContent = emInitials(name);
     }*/

    function emUpdateLeaveBar(val) {
        const v = Math.min(Math.max(parseFloat(val) || 0, 0), 26.4);
        const pct = Math.min((v / 26.4) * 100, 100);

        document.getElementById('em-leave-fill').style.width = pct + '%';
        document.getElementById('em-leave-text').textContent = v.toFixed(1) + ' / 26.4 days';
        document.getElementById('em-leave-counter').textContent = v.toFixed(1) + ' / 26.4';
    }

    /* ── Open modal ───────────────────────────────────────────── */
    function openEmployeeModal(btn) {
        const d = btn.dataset;

        /* Populate fields */
        document.getElementById('em-user-id').value = d.userid || '';
        document.getElementById('em-id-display').textContent = String(d.userid || '0').padStart(6, '0');
        document.getElementById('em-name').value = d.name || '';
        document.getElementById('em-role').value = d.role || '';
        document.getElementById('em-email').value = d.email || '';
        document.getElementById('em-phone').value = d.phone || '';
        document.getElementById('em-entrance').value = d.entrance || '';
        document.getElementById('em-latest-leave').value = d.latestleave || '';


        const isFemale = d.gender === 'female';
        const avatarImg = document.getElementById('em-avatar-img');
        avatarImg.style.background = isFemale ? '#f8bbd0' : '#e8f0fe';

        document.getElementById('em-avatar-img').src =
                contextPath + '/AvatarServlet?userId=' + d.userid;

        const balance = parseInt(d.leavebalance) || 0;
        document.getElementById('em-leave-balance').value = balance;
        emUpdateLeaveBar(balance);

        /* Reset feedback */
        document.getElementById('em-toast').style.display = 'none';
        document.getElementById('em-error').style.display = 'none';

        /* Show overlay */
        const overlay = document.getElementById('employeeModal');
        overlay.style.display = 'flex';
        /* Trap focus on first input */
        setTimeout(() => document.getElementById('em-name').focus(), 50);

        /* Close on overlay click */
        overlay.onclick = function (e) {
            if (e.target === overlay)
                closeEmployeeModal();
        };
    }

    /* ── Close modal ──────────────────────────────────────────── */
    function closeEmployeeModal() {
        document.getElementById('employeeModal').style.display = 'none';
    }

    /* Close on Escape */
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape')
            closeEmployeeModal();
    });

    /* ── Save ─────────────────────────────────────────────────── */
    function emSaveEmployee() {
        const saveBtn = document.querySelector('.em-btn-save');
        const toast = document.getElementById('em-toast');
        const errBox = document.getElementById('em-error');
        const errMsg = document.getElementById('em-error-msg');

        /* Basic validation */
        const name = document.getElementById('em-name').value.trim();
        if (!name) {
            errMsg.textContent = 'Full name is required.';
            errBox.style.display = 'flex';
            toast.style.display = 'none';
            document.getElementById('em-name').focus();
            return;
        }

        saveBtn.disabled = true;
        errBox.style.display = 'none';

        fetch('UpdateEmployeeServlet', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(payload)
        })
                .then(function (res) {
                    if (!res.ok)
                        throw new Error('Server error ' + res.status);
                    return res.json();
                })
                .then(function () {
                    /* Show success toast, then close */
                    toast.style.display = 'flex';
                    setTimeout(function () {
                        toast.style.display = 'none';
                        closeEmployeeModal();
                        /* Optional: refresh the employee card in the grid */
                        // location.reload();
                    }, 1500);
                })
                .catch(function (err) {
                    errMsg.textContent = err.message || 'Could not save. Please try again.';
                    errBox.style.display = 'flex';
                })
                .finally(function () {
                    saveBtn.disabled = false;
                });
    }
</script>

